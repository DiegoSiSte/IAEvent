# Backend host (§9): appropriate local network interface.
HOST=0.0.0.0

# Backend port.
PORT=8000

# Frontend configuration (§9): backend API URL (local Wi-Fi, no Internet needed).
API_BASE_URL=http://192.168.1.100:8000

# Initial USB webcam source (§9): OpenCV index.
CAMERA_SOURCE=0

# Umbral mínimo de confianza (0-1) para identificación facial (M5 - Diego).
CONFIDENCE_THRESHOLD=0.6

# Intervalo (segundos) del ciclo de reconocimacial en segundo plano.
RECOGNITION_INTERVAL=1.5
